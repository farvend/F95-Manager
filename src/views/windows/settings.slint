import { CheckBox, ComboBox, LineEdit, Slider, ScrollView } from "std-widgets.slint";
import { SuggestionData, Theme, Translations, FlatButton } from "../shared.slint";
import { SectionTitle } from "../filters/components.slint";

export enum LanguageChoice { automatic, english, russian }
export enum LoadingIndicatorChoice { bottom-bar, circle-bottom-right }

component SettingsPicker inherits Rectangle {
    in property <string> placeholder;
    in property <int> kind;
    in property <[SuggestionData]> suggestions;
    in property <int> suggestion-kind;
    in property <[SuggestionData]> values;
    callback query(string, int);
    callback add(string, int);
    callback remove(string, int);
    in-out property <string> text;
    in-out property <int> selected-index: 0;
    height: 32px + root.values.length * 28px;
    background: transparent;
    LineEdit {
        width: parent.width;
        height: 32px;
        text <=> root.text;
        placeholder-text: root.placeholder;
        changed text => { root.selected-index = 0; root.query(self.text, root.kind); }
        key-pressed(event) => {
            if (event.text == Key.DownArrow && root.suggestions.length > 0) {
                root.selected-index = min(root.suggestions.length - 1, root.selected-index + 1); accept
            } else if (event.text == Key.UpArrow && root.suggestions.length > 0) {
                root.selected-index = max(0, root.selected-index - 1); accept
            } else if (event.text == Key.Return && root.suggestion-kind == root.kind && root.suggestions.length > 0) {
                root.add(root.suggestions[root.selected-index].id, root.kind);
                root.text = "";
                accept
            } else { reject }
        }
    }
    if root.suggestion-kind == root.kind && root.text != "": Rectangle {
        y: 32px;
        width: parent.width;
        height: suggestion-list.preferred-height + 6px;
        background: #202020;
        border-width: 1px;
        border-color: #4b4b4b;
        border-radius: 5px;
        z: 20;
        suggestion-list := VerticalLayout {
            padding: 3px;
            spacing: 2px;
            for suggestion[index] in root.suggestions: FlatButton {
                height: 26px;
                text: suggestion.label;
                active: index == root.selected-index;
                clicked => { root.add(suggestion.id, root.kind); root.text = ""; }
            }
        }
    }
    for item[index] in root.values: FlatButton {
        y: 35px + index * 28px;
        width: parent.width;
        height: 25px;
        text: item.label + "  ×";
        danger: true;
        clicked => { root.remove(item.id, root.kind); }
    }
}

export component SettingsWindow inherits Window {
    title: Translations.settings-title + " — F95 standalone client";
    preferred-width: 560px;
    preferred-height: 470px;
    min-width: 440px;
    min-height: 400px;
    background: #1d1d1d;
    in-out property <float> ui-scale-percent: 100;
    in-out property <float> card-scale-percent: 100;
    in-out property <int> image-cache-games: 12;
    in-out property <string> cache-directory;
    in-out property <string> temp-directory;
    in-out property <string> games-directory;
    in-out property <string> custom-launch;
    in-out property <bool> log-to-file;
    in-out property <bool> show-unplayed;
    in-out property <bool> classic-library;
    in-out property <LanguageChoice> language;
    in-out property <LoadingIndicatorChoice> loading-indicator;
    in-out property <int> bookmarks-visible: 3;
    in-out property <int> bookmark-red: 60;
    in-out property <int> bookmark-green: 120;
    in-out property <int> bookmark-blue: 200;
    in property <[SuggestionData]> filter-suggestions;
    in-out property <int> filter-suggestion-kind: -1;
    in property <[SuggestionData]> startup-tags;
    in property <[SuggestionData]> startup-exclude-tags;
    in property <[SuggestionData]> startup-prefixes;
    in property <[SuggestionData]> startup-exclude-prefixes;
    in property <[SuggestionData]> warning-tags;
    in property <[SuggestionData]> warning-prefixes;
    in-out property <string> saved-message;
    in-out property <bool> migration-confirm-visible: false;
    in-out property <bool> migration-running: false;
    in-out property <string> migration-message;
    callback preview-scale(float, float);
    callback settings-suggestion-query(string, int);
    callback add-settings-filter(string, int);
    callback remove-settings-filter(string, int);
    callback choose-directory(int);
    callback save-settings(float, float, int, string, string, string, string, bool, bool, bool, LanguageChoice, LoadingIndicatorChoice, int, int, int, int);
    callback open-bookmarks();
    callback confirm-migration(bool);
    ScrollView {
      viewport-width: self.width;
      VerticalLayout {
        padding: 22px; spacing: 10px;
        Text { text: Translations.settings-title; color: #eeeeee; font-size: 25px; }
        Rectangle { height: 1px; background: #414141; }
        Text { text: Translations.settings-folders; color: #dddddd; font-size: 18px; }
        SectionTitle { left: Translations.settings-temp-folder; right: ""; }
        HorizontalLayout { height: 34px; spacing: 6px; LineEdit { text <=> root.temp-directory; } FlatButton { width: 92px; text: Translations.settings-choose; clicked => { root.choose-directory(0); } } }
        SectionTitle { left: Translations.settings-games-folder; right: ""; }
        HorizontalLayout { height: 34px; spacing: 6px; LineEdit { text <=> root.games-directory; } FlatButton { width: 92px; text: Translations.settings-choose; clicked => { root.choose-directory(1); } } }
        SectionTitle { left: Translations.settings-cache-folder; right: Translations.settings-cover-metadata; }
        HorizontalLayout { height: 34px; spacing: 6px; LineEdit { text <=> root.cache-directory; } FlatButton { width: 92px; text: Translations.settings-choose; clicked => { root.choose-directory(2); } } }
        Rectangle { height: 1px; background: #414141; }
        Text { text: Translations.settings-bookmarks; color: #dddddd; font-size: 18px; }
        FlatButton { text: Translations.settings-bookmarks; clicked => { root.open-bookmarks(); } }
        SectionTitle { left: Translations.settings-bookmark-cover-count; right: root.bookmarks-visible; }
        Slider { height: 30px; minimum: 1; maximum: 5; value: root.bookmarks-visible; changed value => { root.bookmarks-visible = round(self.value); } }
        SectionTitle { left: Translations.settings-bookmark-color; right: "RGB " + root.bookmark-red + ", " + root.bookmark-green + ", " + root.bookmark-blue; }
        Rectangle { height: 22px; border-radius: 5px; background: rgb(root.bookmark-red, root.bookmark-green, root.bookmark-blue); border-width: 1px; border-color: #555555; }
        SectionTitle { left: Translations.settings-color-red; right: root.bookmark-red; }
        Slider { height: 25px; minimum: 0; maximum: 255; value: root.bookmark-red; changed value => { root.bookmark-red = round(self.value); } }
        SectionTitle { left: Translations.settings-color-green; right: root.bookmark-green; }
        Slider { height: 25px; minimum: 0; maximum: 255; value: root.bookmark-green; changed value => { root.bookmark-green = round(self.value); } }
        SectionTitle { left: Translations.settings-color-blue; right: root.bookmark-blue; }
        Slider { height: 25px; minimum: 0; maximum: 255; value: root.bookmark-blue; changed value => { root.bookmark-blue = round(self.value); } }
        Rectangle { height: 1px; background: #414141; }
        Text { text: Translations.settings-interface; color: #dddddd; font-size: 18px; }
        SectionTitle { left: Translations.settings-language; right: ""; }
        language-combo := ComboBox {
            height: 34px;
            model: Translations.settings-language-options;
            current-index: root.language == LanguageChoice.english ? 1 : root.language == LanguageChoice.russian ? 2 : 0;
            changed current-index => {
                root.language = self.current-index == 1 ? LanguageChoice.english
                    : self.current-index == 2 ? LanguageChoice.russian
                    : LanguageChoice.automatic;
            }
        }
        SectionTitle { left: Translations.settings-loading-animation; right: ""; }
        loading-combo := ComboBox {
            height: 34px;
            model: Translations.settings-loading-options;
            current-index: root.loading-indicator == LoadingIndicatorChoice.circle-bottom-right ? 1 : 0;
            changed current-index => {
                root.loading-indicator = self.current-index == 1
                    ? LoadingIndicatorChoice.circle-bottom-right
                    : LoadingIndicatorChoice.bottom-bar;
            }
        }
        SectionTitle { left: Translations.settings-ui-scale; right: root.ui-scale-percent + "%"; }
        Slider {
            height: 32px; minimum: 50; maximum: 200; value <=> root.ui-scale-percent;
            changed value => { root.preview-scale(root.ui-scale-percent, root.card-scale-percent); }
        }
        SectionTitle { left: Translations.settings-card-scale; right: root.card-scale-percent + "%"; }
        Slider {
            height: 32px; minimum: 50; maximum: 200; value <=> root.card-scale-percent;
            changed value => { root.preview-scale(root.ui-scale-percent, root.card-scale-percent); }
        }
        SectionTitle { left: Translations.settings-image-cache-games; right: root.image-cache-games; }
        Slider {
            height: 32px; minimum: 1; maximum: 100; value: root.image-cache-games;
            changed value => { root.image-cache-games = round(self.value); }
        }
        CheckBox { text: Translations.settings-log-file; checked <=> root.log-to-file; }
        CheckBox { text: Translations.settings-show-unplayed; checked <=> root.show-unplayed; }
        CheckBox { text: Translations.settings-classic-library; checked <=> root.classic-library; }
        SectionTitle { left: Translations.settings-custom-launch; right: "{{path}}"; }
        LineEdit { height: 34px; text <=> root.custom-launch; placeholder-text: "\"C:\\Start.exe\" {{path}}"; }
        Rectangle { height: 1px; background: #414141; }
        Text { text: Translations.settings-startup-filters; color: #dddddd; font-size: 18px; }
        SectionTitle { left: Translations.settings-add-tags; right: Translations.settings-max-ten; }
        SettingsPicker { kind: 0; placeholder: Translations.settings-startup-tag-placeholder; suggestions: root.filter-suggestions; suggestion-kind: root.filter-suggestion-kind; values: root.startup-tags; query(query, kind) => { root.settings-suggestion-query(query, kind); } add(id, kind) => { root.add-settings-filter(id, kind); } remove(id, kind) => { root.remove-settings-filter(id, kind); } }
        SectionTitle { left: Translations.settings-exclude-tags; right: Translations.settings-max-ten; }
        SettingsPicker { kind: 1; placeholder: Translations.settings-startup-exclude-tag-placeholder; suggestions: root.filter-suggestions; suggestion-kind: root.filter-suggestion-kind; values: root.startup-exclude-tags; query(query, kind) => { root.settings-suggestion-query(query, kind); } add(id, kind) => { root.add-settings-filter(id, kind); } remove(id, kind) => { root.remove-settings-filter(id, kind); } }
        SectionTitle { left: Translations.settings-add-prefixes; right: Translations.settings-max-ten; }
        SettingsPicker { kind: 2; placeholder: Translations.settings-startup-prefix-placeholder; suggestions: root.filter-suggestions; suggestion-kind: root.filter-suggestion-kind; values: root.startup-prefixes; query(query, kind) => { root.settings-suggestion-query(query, kind); } add(id, kind) => { root.add-settings-filter(id, kind); } remove(id, kind) => { root.remove-settings-filter(id, kind); } }
        SectionTitle { left: Translations.settings-exclude-prefixes; right: Translations.settings-max-ten; }
        SettingsPicker { kind: 3; placeholder: Translations.settings-startup-exclude-prefix-placeholder; suggestions: root.filter-suggestions; suggestion-kind: root.filter-suggestion-kind; values: root.startup-exclude-prefixes; query(query, kind) => { root.settings-suggestion-query(query, kind); } add(id, kind) => { root.add-settings-filter(id, kind); } remove(id, kind) => { root.remove-settings-filter(id, kind); } }
        Rectangle { height: 1px; background: #414141; }
        Text { text: Translations.settings-warnings; color: #dddddd; font-size: 18px; }
        SectionTitle { left: Translations.settings-warning-tags; right: ""; }
        SettingsPicker { kind: 4; placeholder: Translations.settings-warning-tag-placeholder; suggestions: root.filter-suggestions; suggestion-kind: root.filter-suggestion-kind; values: root.warning-tags; query(query, kind) => { root.settings-suggestion-query(query, kind); } add(id, kind) => { root.add-settings-filter(id, kind); } remove(id, kind) => { root.remove-settings-filter(id, kind); } }
        SectionTitle { left: Translations.settings-warning-prefixes; right: ""; }
        SettingsPicker { kind: 5; placeholder: Translations.settings-warning-prefix-placeholder; suggestions: root.filter-suggestions; suggestion-kind: root.filter-suggestion-kind; values: root.warning-prefixes; query(query, kind) => { root.settings-suggestion-query(query, kind); } add(id, kind) => { root.add-settings-filter(id, kind); } remove(id, kind) => { root.remove-settings-filter(id, kind); } }
        Text { text: root.saved-message; color: #cf6b72; font-size: 13px; }
        FlatButton {
            height: 36px; text: Translations.settings-save; active: true;
            clicked => { root.save-settings(
                root.ui-scale-percent, root.card-scale-percent, root.image-cache-games, root.temp-directory,
                root.games-directory, root.cache-directory, root.custom-launch,
                root.log-to-file, root.show-unplayed, root.classic-library,
                root.language, root.loading-indicator,
                root.bookmarks-visible, root.bookmark-red, root.bookmark-green, root.bookmark-blue
            ); }
        }
        Rectangle { height: 8px; }
      }
    }
    if root.migration-confirm-visible: Rectangle {
        background: #00000099;
        z: 100;
        TouchArea { }
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: min(430px, parent.width - 30px);
            height: 150px;
            background: #252525; border-width: 1px; border-color: #555555; border-radius: 8px;
            VerticalLayout {
                padding: 14px; spacing: 10px;
                Text { text: root.migration-running ? Translations.migration-progress : Translations.migration-confirm; color: #eeeeee; font-size: 16px; wrap: word-wrap; horizontal-alignment: center; }
                if root.migration-message != "": Text { text: root.migration-message; color: #d47a80; font-size: 12px; wrap: word-wrap; }
                Rectangle { vertical-stretch: 1; }
                if !root.migration-running: HorizontalLayout {
                    height: 32px; spacing: 7px;
                    FlatButton { horizontal-stretch: 1; text: Translations.common-cancel; clicked => { root.confirm-migration(false); } }
                    FlatButton { horizontal-stretch: 1; text: Translations.migration-move; active: true; clicked => { root.confirm-migration(true); } }
                }
            }
        }
    }
}
