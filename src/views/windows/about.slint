import { Translations } from "../shared.slint";

export component AboutWindow inherits Window {
    title: Translations.about-title + " — F95 standalone client";
    preferred-width: 420px;
    preferred-height: 180px;
    min-width: 360px;
    min-height: 160px;
    background: #1d1d1d;
    in property <string> repository-url;
    callback open-repository();
    VerticalLayout {
        padding: 28px;
        spacing: 10px;
        alignment: start;
        Text { text: "F95 standalone client"; color: #eeeeee; font-size: 24px; }
        Text { text: Translations.about-version; color: #a6a6a6; font-size: 14px; }
        link := TouchArea {
            height: url-text.preferred-height;
            mouse-cursor: pointer;
            clicked => { root.open-repository(); }
            url-text := Text {
                x: 0;
                text: root.repository-url;
                color: link.has-hover ? #e0737b : #d65761;
                font-size: 14px;
            }
        }
    }
}
