import { ScrollView } from "std-widgets.slint";
import { FlatButton, Translations } from "../shared.slint";

export component LogsWindow inherits Window {
    title: Translations.logs-title + " — F95 standalone client";
    preferred-width: 900px;
    preferred-height: 600px;
    min-width: 520px;
    min-height: 340px;
    background: #1b1b1b;
    in property <string> contents;
    callback refresh();
    callback clear();
    callback copy();
    VerticalLayout {
        padding: 14px;
        spacing: 8px;
        HorizontalLayout {
            height: 34px; spacing: 8px;
            Text { text: Translations.logs-title; color: #eeeeee; font-size: 23px; vertical-alignment: center; }
            Rectangle { horizontal-stretch: 1; }
            FlatButton { width: 110px; text: Translations.common-refresh; clicked => { root.refresh(); } }
            FlatButton { width: 100px; text: Translations.logs-copy; clicked => { root.copy(); } }
            FlatButton { width: 100px; text: Translations.logs-clear; danger: true; clicked => { root.clear(); } }
        }
        Rectangle {
            border-width: 1px; border-color: #3d3d3d; background: #121212;
            ScrollView {
                viewport-width: self.width;
                viewport-height: log-text.preferred-height + 18px;
                // Read-only TextInput: mouse selection, Ctrl+A and Ctrl+C work
                // across lines, unlike separate Text items.
                log-text := TextInput {
                    x: 10px; y: 9px; width: parent.width - 20px;
                    height: self.preferred-height;
                    text: root.contents;
                    read-only: true;
                    single-line: false;
                    wrap: word-wrap;
                    color: #c8c8c8;
                    selection-background-color: #2f5f9f;
                    selection-foreground-color: #ffffff;
                    font-family: "Consolas"; font-size: 12px;
                }
            }
        }
    }
}
