import { ListView } from "std-widgets.slint";
import { GameRowData, TagRowData, Theme, FlatButton } from "../shared.slint";
import { GameCard } from "../cards/game_card.slint";

export component CatalogView inherits Rectangle {
    in property <[GameRowData]> game-rows;
    // Keep the viewport outside ListView: replacing game-rows must not reset
    // the visible part of the catalog/library.
    in-out property <length> scroll-y: 0px;
    in property <bool> loading;
    in property <string> status-text;
    in property <string> page-label;
    in property <string> active-tag-card-id;
    callback layout-width-changed(float);
    callback previous-page();
    callback next-page();
    callback image-needed(string);
    callback primary-action(string);
    callback open-thread(string);
    callback hide-game(string);
    callback open-folder(string);
    callback context-requested(string, bool, bool, length, length);
    callback tags-hovered(string, [TagRowData], length, length, length, bool);
            background: #191919;
            horizontal-stretch: 1;
            changed width => { root.layout-width-changed(self.width / 1px); }
            VerticalLayout {
                spacing: 0px;
                Rectangle {
                    vertical-stretch: 1;
                    if root.loading: Text {
                        text: root.status-text;
                        color: #b8b8b8;
                        font-size: 17px * Theme.scale;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    if !root.loading && root.game-rows.length == 0: Text {
                        text: root.status-text;
                        color: #999999;
                        font-size: 17px * Theme.scale;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    if !root.loading && root.game-rows.length > 0: ListView {
                        viewport-x: 0px;
                        viewport-y <=> root.scroll-y;
                        viewport-width: self.width;
                        for row in root.game-rows: HorizontalLayout {
                            padding-left: 14px * Theme.scale;
                            padding-right: 10px * Theme.scale;
                            padding-top: 8px * Theme.scale;
                            spacing: 10px * Theme.scale;
                            for card in row.cards: GameCard {
                                    game: card;
                                    active-tag-card-id: root.active-tag-card-id;
                                    image-needed(id) => { root.image-needed(id); }
                                    primary-action(id) => { root.primary-action(id); }
                                    open-thread(id) => { root.open-thread(id); }
                                    hide-game(id) => { root.hide-game(id); }
                                    open-folder(id) => { root.open-folder(id); }
                                    context-requested(id, installed, pending-removable, x, y) => {
                                        root.context-requested(id, installed, pending-removable, x, y);
                                    }
                                    tags-hovered(id, rows, x, y, width, active) => {
                                        root.tags-hovered(id, rows, x, y, width, active);
                                    }
                            }
                            Rectangle { horizontal-stretch: 1; }
                        }
                    }
                }
                Rectangle {
                    height: 43px * Theme.scale;
                    background: #202020;
                    // Only the line towards the cards: a full frame doubled up
                    // with the window edge and the filters panel's border.
                    Rectangle { y: 0; height: 1px; background: #343434; }
                    HorizontalLayout {
                        y: (parent.height - self.height) / 2;
                        height: 31px * Theme.scale;
                        alignment: center;
                        spacing: 14px * Theme.scale;
                        // Arrows are drawn shapes, not ◀/▶ glyphs: the glyphs sit
                        // off-centre in Segoe UI Symbol and turn into emoji with
                        // other fonts.
                        FlatButton {
                            width: 48px * Theme.scale;
                            clicked => { root.previous-page(); }
                            Path {
                                width: 10px * Theme.scale;
                                height: 12px * Theme.scale;
                                viewbox-width: 10;
                                viewbox-height: 12;
                                fill: #bdbdbd;
                                commands: "M 10 0 L 0 6 L 10 12 Z";
                            }
                        }
                        Text { text: root.page-label; color: #aaaaaa; font-size: 14px * Theme.scale; vertical-alignment: center; }
                        FlatButton {
                            width: 48px * Theme.scale;
                            clicked => { root.next-page(); }
                            Path {
                                width: 10px * Theme.scale;
                                height: 12px * Theme.scale;
                                viewbox-width: 10;
                                viewbox-height: 12;
                                fill: #bdbdbd;
                                commands: "M 0 0 L 10 6 L 0 12 Z";
                            }
                        }
                    }
                }
            }
}
