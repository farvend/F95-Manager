import { ScrollView } from "std-widgets.slint";
import { Accent, AppLineEdit, BookmarkData, SuggestionData, Theme, Translations, FlatButton } from "../shared.slint";
import { SectionTitle, SuggestInput, SelectedFilters, DateStepSlider } from "components.slint";

export component FiltersPanel inherits Rectangle {
    in property <[BookmarkData]> bookmarks;
    in property <[SuggestionData]> include-tag-suggestions;
    in property <[SuggestionData]> exclude-tag-suggestions;
    in property <[SuggestionData]> prefix-suggestions;
    in property <[SuggestionData]> exclude-prefix-suggestions;
    in property <[SuggestionData]> selected-include-tags;
    in property <[SuggestionData]> selected-exclude-tags;
    in property <[SuggestionData]> selected-prefixes;
    in property <[SuggestionData]> selected-exclude-prefixes;
    in-out property <bool> library-mode;
    in-out property <bool> session-mode;
    in-out property <string> search-text;
    in-out property <int> sort-index;
    in-out property <int> date-index;
    in property <string> date-label;
    in-out property <string> include-tag-text;
    in-out property <string> exclude-tag-text;
    in-out property <string> prefix-text;
    in-out property <string> exclude-prefix-text;
    in-out property <int> include-logic: 0;
    in-out property <int> search-mode: 0;
    in-out property <bool> unplayed-only: false;
    in property <bool> classic-library: false;
    /// How many bookmark filters are on; shown while the list is folded.
    in property <int> active-bookmarks: 0;
    private property <bool> search-dirty: false;
    private property <bool> bookmarks-open: false;
    /// Height the panel needs to show everything without scrolling.
    out property <length> content-height: content.preferred-height;
    private property <bool> filters-enabled: !root.session-mode;
    callback refresh-catalog(string);
    callback toggle-library();
    callback select-view(int);
    callback toggle-bookmark(string);
    callback open-settings();
    callback suggestion-query(string, int);
    callback filter-chosen(string, int);
    callback remove-filter(string, int);
    callback sort-chosen(int);
    callback date-chosen(int);
    callback mode-chosen(int, int);
    callback toggle-unplayed();
    callback suggestion-overlay-changed(int, length, length, length, [SuggestionData], int, bool);

            preferred-width: 260px * Theme.scale;
            min-width: 240px;
            max-width: 280px;
            horizontal-stretch: 0;
            background: #1e1e1e;
            // Only the line towards the catalog; see the pager in catalog_view.
            Rectangle { x: 0; width: 1px; background: #373737; z: 1; }
            ScrollView {
                viewport-width: self.width;
                content := VerticalLayout {
                    padding: 11px * Theme.scale;
                    spacing: 6px * Theme.scale;
                    Text { height: 27px * Theme.scale; text: Translations.filters-title; color: #dddddd; font-size: 20px * Theme.scale; }
                    Rectangle { height: 1px; background: #414141; }
                    SectionTitle { enabled: root.filters-enabled; left: Translations.filters-sorting; right: Translations.filters-date; }
                    HorizontalLayout {
                        height: 38px * Theme.scale;
                        spacing: 3px;
                        FlatButton { enabled: root.filters-enabled; horizontal-stretch: 1; text: "🕓"; text-font: "Segoe UI Emoji"; active: root.sort-index == 0; clicked => { root.sort-chosen(0); } }
                        FlatButton { enabled: root.filters-enabled; horizontal-stretch: 1; text: "👍"; text-font: "Segoe UI Emoji"; active: root.sort-index == 1; clicked => { root.sort-chosen(1); } }
                        FlatButton { enabled: root.filters-enabled; horizontal-stretch: 1; text: "👀"; text-font: "Segoe UI Emoji"; active: root.sort-index == 2; clicked => { root.sort-chosen(2); } }
                        FlatButton { enabled: root.filters-enabled; horizontal-stretch: 1; text: "🔤"; text-font: "Segoe UI Emoji"; active: root.sort-index == 3; clicked => { root.sort-chosen(3); } }
                        FlatButton { enabled: root.filters-enabled; horizontal-stretch: 1; text: "⭐"; text-font: "Segoe UI Emoji"; active: root.sort-index == 4; clicked => { root.sort-chosen(4); } }
                    }
                    SectionTitle { enabled: root.filters-enabled; left: Translations.filters-date; right: root.date-label; }
                    DateStepSlider { enabled: root.filters-enabled; value <=> root.date-index; changed(value) => { root.date-chosen(value); } }
                    TouchArea {
                        enabled: root.filters-enabled;
                        height: 18px * Theme.scale;
                        clicked => { if (root.filters-enabled) { root.search-mode = root.search-mode == 0 ? 1 : 0; root.mode-chosen(1, root.search-mode); } }
                        SectionTitle { enabled: root.filters-enabled; left: Translations.filters-search; right: root.search-mode == 0 ? Translations.search-title : Translations.search-creator; }
                    }
                    AppLineEdit {
                        height: 31px * Theme.scale;
                        enabled: root.filters-enabled;
                        text <=> root.search-text;
                        placeholder-text: Translations.filters-search-placeholder;
                        changed text => { root.search-dirty = true; }
                        accepted => { root.search-dirty = false; root.refresh-catalog(root.search-text); }
                    }
                    TouchArea {
                        enabled: root.filters-enabled;
                        height: 18px * Theme.scale;
                        clicked => { if (root.filters-enabled) { root.include-logic = root.include-logic == 0 ? 1 : 0; root.mode-chosen(0, root.include-logic); } }
                        SectionTitle { enabled: root.filters-enabled; left: Translations.filters-tags; right: root.include-logic == 0 ? Translations.logic-or + " / " + Translations.logic-and : Translations.logic-and + " / " + Translations.logic-or; }
                    }
                    SuggestInput {
                        enabled: root.filters-enabled;
                        text <=> root.include-tag-text;
                        placeholder: Translations.filters-tag-placeholder;
                        suggestions: root.include-tag-suggestions; kind: 0;
                        query-changed(query, kind) => { root.suggestion-query(query, kind); }
                        chosen(id, label, kind) => { root.filter-chosen(id, kind); }
                        overlay-changed(kind, x, y, width, values, index, visible) => {
                            root.suggestion-overlay-changed(kind, x, y, width, values, index, visible);
                        }
                    }
                    SelectedFilters { enabled: root.filters-enabled; values: root.selected-include-tags; kind: 0; remove(id, kind) => { root.remove-filter(id, kind); } }
                    SectionTitle { enabled: root.filters-enabled; left: Translations.filters-exclude-tags; right: ""; }
                    SuggestInput {
                        enabled: root.filters-enabled;
                        text <=> root.exclude-tag-text;
                        placeholder: Translations.filters-exclude-tag-placeholder;
                        suggestions: root.exclude-tag-suggestions; kind: 1;
                        query-changed(query, kind) => { root.suggestion-query(query, kind); }
                        chosen(id, label, kind) => { root.filter-chosen(id, kind); }
                        overlay-changed(kind, x, y, width, values, index, visible) => {
                            root.suggestion-overlay-changed(kind, x, y, width, values, index, visible);
                        }
                    }
                    SelectedFilters { enabled: root.filters-enabled; values: root.selected-exclude-tags; kind: 1; remove(id, kind) => { root.remove-filter(id, kind); } }
                    SectionTitle { enabled: root.filters-enabled; left: Translations.filters-prefixes; right: ""; }
                    SuggestInput {
                        enabled: root.filters-enabled;
                        text <=> root.prefix-text;
                        placeholder: Translations.filters-prefix-placeholder;
                        suggestions: root.prefix-suggestions; kind: 2;
                        query-changed(query, kind) => { root.suggestion-query(query, kind); }
                        chosen(id, label, kind) => { root.filter-chosen(id, kind); }
                        overlay-changed(kind, x, y, width, values, index, visible) => {
                            root.suggestion-overlay-changed(kind, x, y, width, values, index, visible);
                        }
                    }
                    SelectedFilters { enabled: root.filters-enabled; values: root.selected-prefixes; kind: 2; remove(id, kind) => { root.remove-filter(id, kind); } }
                    SectionTitle { enabled: root.filters-enabled; left: Translations.settings-exclude-prefixes; right: ""; }
                    SuggestInput {
                        enabled: root.filters-enabled;
                        text <=> root.exclude-prefix-text;
                        placeholder: Translations.settings-startup-exclude-prefix-placeholder;
                        suggestions: root.exclude-prefix-suggestions; kind: 3;
                        query-changed(query, kind) => { root.suggestion-query(query, kind); }
                        chosen(id, label, kind) => { root.filter-chosen(id, kind); }
                        overlay-changed(kind, x, y, width, values, index, visible) => {
                            root.suggestion-overlay-changed(kind, x, y, width, values, index, visible);
                        }
                    }
                    SelectedFilters { enabled: root.filters-enabled; values: root.selected-exclude-prefixes; kind: 3; remove(id, kind) => { root.remove-filter(id, kind); } }
                    Rectangle { height: 1px; background: #383838; }
                    // Bookmarks fold away so the panel stays short; the header
                    // keeps the number of active bookmark filters visible.
                    // The library's "not played" filter shares this row: both
                    // narrow down downloaded games, and the row is always
                    // there, so switching views moves nothing below it.
                    HorizontalLayout {
                        height: 22px * Theme.scale;
                        spacing: 6px * Theme.scale;
                        bookmarks-header := TouchArea {
                            enabled: root.filters-enabled;
                            horizontal-stretch: 1;
                            mouse-cursor: self.enabled ? pointer : default;
                            clicked => { root.bookmarks-open = !root.bookmarks-open; }
                            HorizontalLayout {
                                spacing: 6px * Theme.scale;
                                Path {
                                    width: 8px * Theme.scale;
                                    height: 8px * Theme.scale;
                                    y: (parent.height - self.height) / 2;
                                    viewbox-width: 8;
                                    viewbox-height: 8;
                                    fill: root.filters-enabled ? #9a9a9a : #555555;
                                    commands: root.bookmarks-open ? "M 0 1 L 8 1 L 4 7 Z" : "M 1 0 L 7 4 L 1 8 Z";
                                }
                                Text {
                                    text: root.active-bookmarks > 0
                                        ? Translations.filters-bookmarks + " (" + root.active-bookmarks + ")"
                                        : Translations.filters-bookmarks;
                                    color: !root.filters-enabled ? #555555 : bookmarks-header.has-hover ? #bbbbbb : #888888;
                                    font-size: 13px * Theme.scale;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                            }
                        }
                        if root.library-mode && !root.session-mode: Rectangle {
                            width: unplayed-text.preferred-width + 18px * Theme.scale;
                            border-radius: self.height / 2;
                            border-width: 1px;
                            border-color: root.unplayed-only ? Accent.base : unplayed-touch.has-hover ? #5a5a5a : #444444;
                            background: root.unplayed-only ? #3a2224 : unplayed-touch.has-hover ? #2c2c2c : transparent;
                            unplayed-text := Text {
                                text: Translations.filters-unplayed;
                                font-size: 12px * Theme.scale;
                                color: root.unplayed-only ? #f0b8bc : #a6a6a6;
                                horizontal-alignment: center; vertical-alignment: center;
                            }
                            unplayed-touch := TouchArea { mouse-cursor: pointer; clicked => { root.toggle-unplayed(); } }
                        }
                    }
                    if root.bookmarks-open: VerticalLayout {
                        spacing: 6px * Theme.scale;
                        for bookmark in root.bookmarks: FlatButton {
                            enabled: root.filters-enabled;
                            text: bookmark.label;
                            active: bookmark.active;
                            clicked => { root.toggle-bookmark(bookmark.id); }
                        }
                    }
                    Rectangle { height: 8px; }
                    if root.classic-library: FlatButton { text: Translations.filters-downloaded; active: root.library-mode && !root.session-mode; clicked => { root.select-view(root.library-mode && !root.session-mode ? 0 : 1); } }
                    if !root.classic-library: HorizontalLayout {
                        height: 31px * Theme.scale; spacing: 6px * Theme.scale;
                        FlatButton { horizontal-stretch: 1; text: Translations.view-catalog; active: !root.library-mode; clicked => { root.select-view(0); } }
                        FlatButton { horizontal-stretch: 1; text: Translations.view-downloaded; active: root.library-mode && !root.session-mode; clicked => { root.select-view(1); } }
                    }
                    FlatButton { text: Translations.view-session; active: root.session-mode; clicked => { root.select-view(root.session-mode ? 0 : 2); } }
                    FlatButton { text: Translations.common-settings; clicked => { root.open-settings(); } }
                    Rectangle { vertical-stretch: 1; }
        }
}

Timer {
    interval: 350ms;
    running: root.filters-enabled && root.search-dirty;
    triggered => { root.search-dirty = false; root.refresh-catalog(root.search-text); }
}
    }
