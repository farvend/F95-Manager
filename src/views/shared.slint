import { CheckBox, ComboBox, LineEdit, Slider, ScrollView, ListView } from "std-widgets.slint";

export struct TagRowData {
    tags: [string],
}

export struct CardBadgeData {
    label: string,
    tooltip: string,
    red: int,
    green: int,
    blue: int,
}

export enum DownloadDisplayMode { bottom-bar, circle-bottom-right }
export enum DownloadVisualState { idle, indeterminate, determinate, error, paused }

export struct GameCardData {
    id: string,
    title: string,
    creator: string,
    version: string,
    prefix: string,
    date: string,
    likes: string,
    views: string,
    rating: string,
    cover: image,
    screens: [image],
    screen-loaded: [bool],
    screen-count: int,
    screens-ready: bool,
    tag-rows: [TagRowData],
    installed: bool,
    pending-removable: bool,
    warning-count: int,
    warning-details: string,
    bookmark-badges: [CardBadgeData],
    unplayed: bool,
    download-state: DownloadVisualState,
    download-progress: float,
    download-display-mode: DownloadDisplayMode,
    download-error: string,
}

export struct GameRowData {
    cards: [GameCardData],
}

export struct BookmarkData {
    id: string,
    label: string,
    active: bool,
}

export struct BookmarkEditorData {
    id: string,
    emoji: string,
    label: string,
    red: int,
    green: int,
    blue: int,
}

export struct SuggestionData {
    id: string,
    label: string,
}

export struct LogLineData {
    text: string,
    red: int,
    green: int,
    blue: int,
}

export component FlatButton inherits Rectangle {
    in property <string> text;
    in property <string> text-font: "Segoe UI";
    in property <bool> active: false;
    in property <bool> danger: false;
    callback clicked;
    height: 31px * Theme.scale;
    border-radius: 5px * Theme.scale;
    border-width: 1px;
    border-color: active ? #824247 : #444444;
    background: touch.pressed ? #3a3031 : touch.has-hover ? #303030 : active ? #392627 : #292929;
    Text {
        text: root.text;
        font-family: root.text-font;
        color: root.danger ? #e68b90 : root.active ? #e96b72 : #bdbdbd;
        font-size: 13px * Theme.scale;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export global Theme {
    in-out property <float> scale: 1.0;
    in-out property <float> card-scale: 1.0;
    in-out property <length> card-width: 320px;
}

